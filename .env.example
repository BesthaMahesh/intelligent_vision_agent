# Environment Configuration for Intelligent Vision Enterprise AI Platform

# Application & Environment
APP_ENV=development
AUTH_ENABLED=true
SESSION_TIMEOUT_MINUTES=60
DATABASE_URL=

# Model Settings
MODEL_NAME=yolo11n.pt
CONFIDENCE_THRESHOLD=0.40
IOU_THRESHOLD=0.45
CONFIDENCE_HIGH_THRESHOLD=0.80
CONFIDENCE_MEDIUM_THRESHOLD=0.60

# Image Constraints
MAX_IMAGE_SIZE_MB=15

# LLM Provider Configuration ("groq", "gemini", "openai", "ollama", "mock")
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
ENABLE_VISION_LLM=true

# API Keys (Set your respective key or provide in Streamlit sidebar)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Guardrails
MAX_QUESTION_LENGTH=300
ENABLE_GUARDRAILS=true

# Observability
LOG_LEVEL=INFO
LOG_FILE=logs/vision_agent.log
